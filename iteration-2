class Sprite:
    def __init__(self,xpos,ypos,xsize,ysize):
        self.xpos = xpos
        self.ypos = ypos

        self.xsize = xsize
        self.ysize = ysize

        self.xvelocity = 0
        self.yvelocity = 0
        self.xacceleration = 0
        self.yacceleration = 0
        
        self.health = 999
        self.dmg = 0
        self.iframedmg = 0
        self.iframes = 0
        
        
        self.colour = (100,0,0)
        self.transparency = 0

        spritelist.append(self)
        

        
    def Remove(self):
        
        spritelist.remove(self)
    

        
    def ChangeVelocity(self,xvelocity,yvelocity):
        self.xvelocity = xvelocity
        self.yvelocity = yvelocity
        
    def ChangeAcceleration(self,xacceleration,yacceleration):
        self.xacceleration = xacceleration
        self.yacceleration = yacceleration
    def ChangeHealth(self,health):
        self.health = health
    def ChangeDmgIframeDmg(self,dmg,iframedmg):
        self.dmg = dmg
        self.iframedmg = iframedmg

    def ChangeColourTransparency(self,colour,transparency):
        self.colour = colour
        self.transparency = transparency

    def PhysicsStep(self):
        self.xpos += self.xvelocity
        self.xvelocity += self.xacceleration
        
        self.ypos -= self.yvelocity
        self.yvelocity += self.yacceleration

        if hasattr(self,"lifetime"):
            self.lifetime -= 1
            if self.lifetime ==0:
                self.Remove()   
        if self.iframes > 0:
            self.iframes -= 1

    def CheckForCollisions(self):
        if self.iframes >0:
            return
        
        for sprite in spritelist:
            if sprite == self:
                continue
            elif self.xpos + self.xsize//2 > sprite.xpos - sprite.xsize//2 and self.xpos - self.xsize//2 < sprite.xpos + sprite.xsize//2:
                if self.ypos + self.ysize//2 > sprite.ypos - sprite.ysize//2 and self.ypos - self.ysize//2 < sprite.ypos + sprite.ysize//2:
                    if sprite.dmg != 0:
                        self.iframes += sprite.iframedmg *framerate
                        self.health -= sprite.dmg
                        print(self.health)
                        if self.health <= 0:
                            self.ChangeColourTransparency((255,0,0),0)
                        return 
                    
    def Draw(self):

        if self.iframes ==0 or self.iframes%2 ==0: 
            pygame.draw.rect(screen,self.colour,(self.xpos -self.xsize//2,
                                               self.ypos - self.ysize//2,
                                               self.xsize,
                                               self.ysize))       

class Bullet(Sprite):
    def __init__(self,xpos,ypos,xsize,ysize):
        Sprite.__init__(self,xpos,ypos,xsize,ysize)
        Sprite.ChangeDmgIframeDmg(self,5,.5)
        Sprite.ChangeColourTransparency(self,(150,150,0),0)
        
    def ChangeLifetime(self,lifetime):
        self.lifetime = lifetime

    
